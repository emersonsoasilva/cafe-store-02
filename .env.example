# Gerado automaticamente pelo "npm run build" (com segredos aleatórios) se não existir .env.
# NUNCA versione o .env real.

# Vazio = tenta a porta 80 (o professor digita só o IP, ex.: http://10.81.211.26)
# e, se estiver ocupada, usa a 3000 (aí precisa digitar http://IP:3000).
PORT=
# 0.0.0.0 = aceita acessos de outras máquinas da rede (o professor pelo seu IP).
HOST=0.0.0.0
NODE_ENV=development

# Endereço usado no link de "esqueci minha senha". Vazio = detecta o IP da máquina.
# Ex.: PUBLIC_URL=http://192.168.0.15:3000
PUBLIC_URL=

# Banco NoSQL embutido (NeDB): pasta onde ficam os arquivos das coleções.
DATA_DIR=./data

# Deixe vazio: o front é servido pelo próprio servidor (mesma origem).
CORS_ORIGIN=

# Só mude para true quando o site estiver atrás de HTTPS.
HTTPS_ENABLED=false
COOKIE_SECURE=false
# Só true atrás de proxy reverso (Nginx, Render...).
TRUST_PROXY=false

# Simulador de atividade (tela "Simulador", só admin).
# Cada fase dura SIMULATOR_PHASE_SECONDS e repete UMA atividade sorteada
# (criar usuários, produtos ou compras) a cada SIMULATOR_ACTION_INTERVAL_SECONDS.
SIMULATOR_PHASE_SECONDS=30
SIMULATOR_ACTION_INTERVAL_SECONDS=3

# Preenchidos automaticamente pelo build com valores aleatórios.
JWT_SECRET=
FIELD_ENCRYPTION_KEY=
